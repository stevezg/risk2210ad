.root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.panel {
    background-color: rgba(6, 12, 24, 0.82);
    border-color: rgba(60, 170, 220, 0.45);
    border-width: 1px;
    border-radius: 10px;
    padding: 10px 14px;
}

.top-bar { position: absolute; top: 12px; left: 50%; translate: -50% 0; flex-direction: row; align-items: center; }
.title { color: rgb(255, 80, 70); font-size: 22px; -unity-font-style: bold; letter-spacing: 4px; margin-right: 18px; }
.year-track { flex-direction: row; margin-right: 18px; }
.year { width: 62px; height: 22px; margin: 0 3px; border-radius: 5px; background-color: rgba(30, 60, 90, 0.8); color: rgb(150, 180, 210);
        -unity-text-align: middle-center; font-size: 12px; }
.year.active { background-color: rgb(80, 220, 255); color: rgb(5, 15, 25); -unity-font-style: bold; }
.year.done { background-color: rgba(60, 120, 160, 0.6); color: rgb(200, 220, 240); }
.phase { color: rgb(255, 190, 80); font-size: 13px; letter-spacing: 2px; margin-right: 18px; -unity-font-style: bold; }
.row { flex-direction: row; }

.side-panel { position: absolute; top: 80px; width: 330px; bottom: 150px; }
.left { left: 12px; }
.right { right: 12px; }
.section { color: rgb(80, 220, 255); font-size: 11px; letter-spacing: 3px; margin-top: 10px; margin-bottom: 6px; border-bottom-width: 1px; border-bottom-color: rgba(80, 220, 255, 0.4); }

.player-row { flex-direction: row; align-items: center; margin-bottom: 4px; padding: 4px; border-radius: 4px; }
.player-row.current { background-color: rgba(80, 220, 255, 0.12); }
.swatch { width: 12px; height: 12px; border-radius: 6px; margin-right: 8px; }
.player-name { color: rgb(220, 235, 255); font-size: 13px; width: 70px; -unity-font-style: bold; }
.player-stats { color: rgb(160, 185, 210); font-size: 11px; }
.region-row { color: rgb(160, 185, 210); font-size: 11px; flex-direction: row; justify-content: space-between; }

.prompt-title { color: rgb(255, 190, 80); font-size: 16px; -unity-font-style: bold; white-space: normal; }
.prompt-text { color: rgb(210, 230, 255); font-size: 13px; white-space: normal; margin-top: 4px; margin-bottom: 8px; }
.actions { flex-direction: row; flex-wrap: wrap; }
.btn { background-color: rgba(20, 60, 100, 0.9); border-color: rgba(80, 200, 240, 0.7); border-width: 1px; border-radius: 6px;
       color: rgb(220, 240, 255); padding: 6px 10px; margin: 3px; font-size: 12px; }
.btn:hover { background-color: rgba(40, 110, 170, 0.95); }
.btn:disabled { opacity: 0.35; }
.btn.primary { background-color: rgba(30, 120, 80, 0.9); border-color: rgba(120, 255, 180, 0.7); }
.btn.danger { background-color: rgba(120, 30, 40, 0.9); border-color: rgba(255, 120, 120, 0.7); }
.btn.toggled { background-color: rgba(160, 110, 20, 0.95); border-color: rgb(255, 200, 80); }
.btn.small { padding: 3px 8px; font-size: 11px; }
.status { color: rgb(255, 130, 110); font-size: 12px; white-space: normal; margin-top: 4px; }

.hand-scroll { flex-grow: 1; }
.hand { flex-direction: column; }
.card { background-color: rgba(20, 40, 70, 0.9); border-width: 1px; border-color: rgba(120, 150, 200, 0.5); border-radius: 6px; padding: 6px 8px; margin-bottom: 5px; }
.card.playable { border-color: rgb(80, 220, 255); background-color: rgba(30, 70, 110, 0.95); }
.card.playable:hover { background-color: rgba(50, 110, 170, 1); }
.card-name { color: rgb(230, 240, 255); font-size: 12px; -unity-font-style: bold; }
.card-meta { color: rgb(255, 190, 80); font-size: 10px; letter-spacing: 1px; }
.card-icon { width: 18px; height: 18px; border-radius: 9px; margin-right: 6px; -unity-text-align: middle-center; font-size: 10px; -unity-font-style: bold; color: rgb(5,15,25); }
.deck-Land { background-color: rgb(120, 220, 120); }
.deck-Diplomat { background-color: rgb(240, 200, 90); }
.deck-Naval { background-color: rgb(90, 170, 255); }
.deck-Nuclear { background-color: rgb(255, 110, 90); }
.deck-Space { background-color: rgb(200, 150, 255); }

.bottom-bar { position: absolute; left: 12px; right: 12px; bottom: 12px; height: 126px; }
.log { color: rgb(170, 190, 210); font-size: 11px; white-space: normal; }

.tooltip { position: absolute; background-color: rgba(4, 10, 20, 0.96); border-color: rgb(80, 220, 255); border-width: 1px; border-radius: 8px; padding: 8px 10px; max-width: 300px; }
.tooltip-title { color: rgb(80, 220, 255); font-size: 13px; -unity-font-style: bold; }
.tooltip-body { color: rgb(210, 230, 255); font-size: 11px; white-space: normal; margin-top: 4px; }

.game-over { position: absolute; left: 50%; top: 45%; translate: -50% -50%; align-items: center; padding: 30px 40px; }
