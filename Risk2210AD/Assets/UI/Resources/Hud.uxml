<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
  <ui:VisualElement name="root" class="root" picking-mode="Ignore">

    <ui:VisualElement name="top-bar" class="panel top-bar">
      <ui:Label name="title" text="RISK 2210 A.D." class="title" />
      <ui:VisualElement name="year-track" class="year-track" />
      <ui:Label name="phase-label" text="" class="phase" />
      <ui:VisualElement name="spectator" class="row">
        <ui:Button name="pause" text="Pause bots" class="btn small" />
        <ui:Button name="fast" text="Fast forward" class="btn small" />
        <ui:Button name="menu" text="Menu" class="btn small" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="left-panel" class="panel side-panel left">
      <ui:Label text="COMMANDERS" class="section" />
      <ui:VisualElement name="players" />
      <ui:Label text="CONTINENTS &amp; COLONIES" class="section" />
      <ui:VisualElement name="regions" />
    </ui:VisualElement>

    <ui:VisualElement name="right-panel" class="panel side-panel right">
      <ui:Label name="prompt-title" text="" class="prompt-title" />
      <ui:Label name="prompt-text" text="" class="prompt-text" />
      <ui:VisualElement name="actions" class="actions" />
      <ui:Label name="status" text="" class="status" />
      <ui:Label text="COMMAND HAND" class="section" />
      <ui:ScrollView name="hand-scroll" class="hand-scroll">
        <ui:VisualElement name="hand" class="hand" />
      </ui:ScrollView>
    </ui:VisualElement>

    <ui:VisualElement name="bottom-bar" class="panel bottom-bar">
      <ui:Label name="log" text="" class="log" />
    </ui:VisualElement>

    <ui:VisualElement name="tooltip" class="tooltip" picking-mode="Ignore" style="display: none;">
      <ui:Label name="tooltip-title" class="tooltip-title" />
      <ui:Label name="tooltip-body" class="tooltip-body" />
    </ui:VisualElement>

    <ui:VisualElement name="game-over" class="panel game-over" style="display: none;">
      <ui:Label name="game-over-title" text="WORLD LEADER ELECTED" class="title" />
      <ui:Label name="game-over-body" text="" class="prompt-text" />
      <ui:Button name="game-over-menu" text="Back to menu" class="btn" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
